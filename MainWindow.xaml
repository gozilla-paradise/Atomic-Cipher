<Window x:Class="AtomicCipher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AtomicCipher — Post-Quantum File Encryption"
        Height="750" Width="780"
        MinHeight="750" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E0A"
        FontFamily="Consolas">
    <Window.Resources>
        <!-- Color Brushes -->
        <SolidColorBrush x:Key="HudBackground" Color="#0A0E0A"/>
        <SolidColorBrush x:Key="HudPanelBg" Color="#0D1A0D"/>
        <SolidColorBrush x:Key="HudGreen" Color="#00FF41"/>
        <SolidColorBrush x:Key="HudGreenDim" Color="#00802A"/>
        <SolidColorBrush x:Key="HudGreenFaint" Color="#003D14"/>
        <SolidColorBrush x:Key="HudText" Color="#B0FFB0"/>
        <SolidColorBrush x:Key="HudTextDim" Color="#4A7A4A"/>
        <SolidColorBrush x:Key="HudBorder" Color="#00CC33"/>
        <SolidColorBrush x:Key="HudInputBg" Color="#050A05"/>
        <SolidColorBrush x:Key="HudAmber" Color="#FFB000"/>
        <SolidColorBrush x:Key="HudDisabledFg" Color="#2A4A2A"/>

        <!-- Glow Effects -->
        <DropShadowEffect x:Key="GlowGreen" Color="#00FF41" ShadowDepth="0" BlurRadius="8" Opacity="0.6"/>
        <DropShadowEffect x:Key="GlowGreenBright" Color="#00FF41" ShadowDepth="0" BlurRadius="15" Opacity="0.8"/>
        <DropShadowEffect x:Key="GlowGreenSubtle" Color="#00FF41" ShadowDepth="0" BlurRadius="5" Opacity="0.3"/>

        <!-- Default TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0FFB0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Header Text -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="5" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A7A4A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ActionButton -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent"
                                BorderBrush="#00CC33" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A3D1A"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="12" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D260D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#003D14"/>
                                <Setter Property="Foreground" Value="#2A4A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BrowseButton -->
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00802A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="[...]"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent"
                                BorderBrush="#00802A" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A3D1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00CC33"/>
                                <Setter Property="Foreground" Value="#00FF41"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="8" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#050A05"/>
            <Setter Property="Foreground" Value="#B0FFB0"/>
            <Setter Property="BorderBrush" Value="#00802A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="#00FF41"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00FF41"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="8" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#050A05" BorderBrush="#00802A" BorderThickness="1" Height="4">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#00FF41">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="8" Opacity="0.6"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Inverse BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- PasswordBox Style -->
        <Style x:Key="HudPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#050A05"/>
            <Setter Property="Foreground" Value="#B0FFB0"/>
            <Setter Property="BorderBrush" Value="#00802A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="#00FF41"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00FF41"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="8" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode Toggle Button -->
        <Style x:Key="ModeToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A7A4A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent"
                                BorderBrush="#003D14" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A3D1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00802A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Mode Toggle Button -->
        <Style x:Key="ModeToggleButtonActive" TargetType="Button">
            <Setter Property="Background" Value="#1A3D1A"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#1A3D1A"
                                BorderBrush="#00CC33" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="6" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: HUD Header Bar -->
        <Border Grid.Row="0" Background="#0A0E0A" Padding="20,12,20,10"
                BorderBrush="#00CC33" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="5" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="18" FontWeight="Bold" Foreground="#00FF41">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="10" Opacity="0.7"/>
                    </TextBlock.Effect>
                    [ ATOMICCIPHER ]
                </TextBlock>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="#4A7A4A">
                    POST-QUANTUM ENCRYPTION
                </TextBlock>
            </Grid>
        </Border>

        <!-- Row 1: Key Management -->
        <Border Grid.Row="1" Background="#0D1A0D" BorderBrush="#00CC33" BorderThickness="1"
                Margin="16,12,16,4" Padding="14,10">
            <Border.Effect>
                <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="5" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <!-- Corner Brackets -->
                <Polyline Points="0,12 0,0 12,0" Stroke="#00FF41" StrokeThickness="2"
                          HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Polyline Points="12,0 0,0 0,12" Stroke="#00FF41" StrokeThickness="2"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          RenderTransformOrigin="0.5,0.5">
                    <Polyline.RenderTransform>
                        <ScaleTransform ScaleX="-1"/>
                    </Polyline.RenderTransform>
                </Polyline>
                <Polyline Points="0,0 0,12 12,12" Stroke="#00FF41" StrokeThickness="2"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          RenderTransformOrigin="0.5,0.5">
                    <Polyline.RenderTransform>
                        <ScaleTransform ScaleX="1"/>
                    </Polyline.RenderTransform>
                </Polyline>
                <Polyline Points="12,0 0,0 0,12" Stroke="#00FF41" StrokeThickness="2"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          RenderTransformOrigin="0.5,0.5">
                    <Polyline.RenderTransform>
                        <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                    </Polyline.RenderTransform>
                </Polyline>

                <StackPanel Margin="8,8">
                    <TextBlock Text="&gt; KEY MANAGEMENT" Style="{StaticResource HeaderText}"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PUBLIC KEY" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding PublicKeyPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Command="{Binding BrowsePublicKeyCommand}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PRIVATE KEY" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Command="{Binding BrowsePrivateKeyCommand}"/>
                    </Grid>
                    <Button Content="[ GENERATE KEY PAIR ]" Style="{StaticResource ActionButton}"
                            Command="{Binding GenerateKeysCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Encrypt + Decrypt Side-by-Side -->
        <Grid Grid.Row="2" Margin="16,4,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Encrypt Panel -->
            <Border Grid.Column="0" Background="#0D1A0D" BorderBrush="#00CC33" BorderThickness="1" Padding="14,10">
                <Border.Effect>
                    <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="5" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <!-- Corner Brackets -->
                    <Polyline Points="0,12 0,0 12,0" Stroke="#00FF41" StrokeThickness="2"
                              HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Polyline Points="12,0 0,0 0,12" Stroke="#00FF41" StrokeThickness="2"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              RenderTransformOrigin="0.5,0.5">
                        <Polyline.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </Polyline.RenderTransform>
                    </Polyline>
                    <Polyline Points="0,0 0,12 12,12" Stroke="#00FF41" StrokeThickness="2"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              RenderTransformOrigin="0.5,0.5">
                        <Polyline.RenderTransform>
                            <ScaleTransform ScaleX="1"/>
                        </Polyline.RenderTransform>
                    </Polyline>
                    <Polyline Points="12,0 0,0 0,12" Stroke="#00FF41" StrokeThickness="2"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              RenderTransformOrigin="0.5,0.5">
                        <Polyline.RenderTransform>
                            <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                        </Polyline.RenderTransform>
                    </Polyline>

                    <StackPanel Margin="8,6">
                        <TextBlock Text="&gt; ENCRYPT" Style="{StaticResource HeaderText}"/>

                        <!-- Mode Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="MODE" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                            <Button Content="[ KEY ]" Command="{Binding SelectKeyModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModeToggleButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyEncryptMode}" Value="True">
                                                <Setter Property="Background" Value="#1A3D1A"/>
                                                <Setter Property="Foreground" Value="#00FF41"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#1A3D1A" BorderBrush="#00CC33" BorderThickness="1" Padding="10,4">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="6" Opacity="0.4"/>
                                                                </Border.Effect>
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="[ PASSPHRASE ]" Command="{Binding SelectPassphraseModeCommand}" Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModeToggleButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPassphraseEncryptMode}" Value="True">
                                                <Setter Property="Background" Value="#1A3D1A"/>
                                                <Setter Property="Foreground" Value="#00FF41"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#1A3D1A" BorderBrush="#00CC33" BorderThickness="1" Padding="10,4">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="6" Opacity="0.4"/>
                                                                </Border.Effect>
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Passphrase Fields (visible in passphrase mode) -->
                        <StackPanel Visibility="{Binding IsPassphraseEncryptMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                            <TextBlock Text="PASSPHRASE" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <PasswordBox x:Name="EncryptPassphraseBox" Style="{StaticResource HudPasswordBox}"
                                         PasswordChanged="EncryptPassphraseBox_PasswordChanged"/>
                            <TextBlock Text="CONFIRM" Style="{StaticResource FieldLabel}" Margin="0,4,0,2"/>
                            <PasswordBox x:Name="EncryptPassphraseConfirmBox" Style="{StaticResource HudPasswordBox}"
                                         PasswordChanged="EncryptPassphraseConfirmBox_PasswordChanged"/>
                        </StackPanel>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SOURCE" Style="{StaticResource FieldLabel}"/>
                            <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Command="{Binding BrowseEncryptSourceCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding EncryptSourcePaths}" Margin="0,4,0,0"
                                      MaxHeight="80">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <Border Background="#050A05" BorderBrush="#00802A" BorderThickness="1" Padding="4,2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#B0FFB0" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding}"/>
                                        <Button Grid.Column="1" Content="x" FontSize="10" Foreground="#00802A" FontFamily="Consolas"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0"
                                                Command="{Binding DataContext.RemoveEncryptPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="SELECT FILES OR DRAG FOLDER PATH" FontSize="10" Foreground="#4A7A4A" Margin="0,2,0,0"/>
                        <Button Content="[ ENCRYPT ]" Style="{StaticResource ActionButton}"
                                Command="{Binding EncryptCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Decrypt Panel -->
            <Border Grid.Column="2" Background="#0D1A0D" BorderBrush="#00CC33" BorderThickness="1" Padding="14,10">
                <Border.Effect>
                    <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="5" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <!-- Corner Brackets -->
                    <Polyline Points="0,12 0,0 12,0" Stroke="#00FF41" StrokeThickness="2"
                              HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Polyline Points="12,0 0,0 0,12" Stroke="#00FF41" StrokeThickness="2"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              RenderTransformOrigin="0.5,0.5">
                        <Polyline.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </Polyline.RenderTransform>
                    </Polyline>
                    <Polyline Points="0,0 0,12 12,12" Stroke="#00FF41" StrokeThickness="2"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              RenderTransformOrigin="0.5,0.5">
                        <Polyline.RenderTransform>
                            <ScaleTransform ScaleX="1"/>
                        </Polyline.RenderTransform>
                    </Polyline>
                    <Polyline Points="12,0 0,0 0,12" Stroke="#00FF41" StrokeThickness="2"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              RenderTransformOrigin="0.5,0.5">
                        <Polyline.RenderTransform>
                            <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                        </Polyline.RenderTransform>
                    </Polyline>

                    <StackPanel Margin="8,4">
                        <TextBlock Text="&gt; DECRYPT" Style="{StaticResource HeaderText}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SOURCE (.ACF)" Style="{StaticResource FieldLabel}"/>
                            <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Command="{Binding BrowseDecryptSourceCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DecryptSourcePaths}" Margin="0,4,0,0"
                                      MaxHeight="80">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <Border Background="#050A05" BorderBrush="#00802A" BorderThickness="1" Padding="4,2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#B0FFB0" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding}"/>
                                        <Button Grid.Column="1" Content="x" FontSize="10" Foreground="#00802A" FontFamily="Consolas"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0"
                                                Command="{Binding DataContext.RemoveDecryptPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="SELECT .ACF FILES TO DECRYPT" FontSize="10" Foreground="#4A7A4A" Margin="0,2,0,0"/>

                        <!-- Decrypt Passphrase -->
                        <TextBlock Text="PASSPHRASE (IF REQUIRED)" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"/>
                        <PasswordBox x:Name="DecryptPassphraseBox" Style="{StaticResource HudPasswordBox}"
                                     PasswordChanged="DecryptPassphraseBox_PasswordChanged"/>

                        <Button Content="[ DECRYPT ]" Style="{StaticResource ActionButton}"
                                Command="{Binding DecryptCommand}" HorizontalAlignment="Left" Margin="0,10,0,24"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 3: Settings -->
        <Border Grid.Row="3" Background="#0D1A0D" BorderBrush="#00CC33" BorderThickness="1"
                Margin="16,4,16,4" Padding="14,10">
            <Border.Effect>
                <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="5" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <!-- Corner Brackets -->
                <Polyline Points="0,12 0,0 12,0" Stroke="#00FF41" StrokeThickness="2"
                          HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Polyline Points="12,0 0,0 0,12" Stroke="#00FF41" StrokeThickness="2"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          RenderTransformOrigin="0.5,0.5">
                    <Polyline.RenderTransform>
                        <ScaleTransform ScaleX="-1"/>
                    </Polyline.RenderTransform>
                </Polyline>
                <Polyline Points="0,0 0,12 12,12" Stroke="#00FF41" StrokeThickness="2"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          RenderTransformOrigin="0.5,0.5">
                    <Polyline.RenderTransform>
                        <ScaleTransform ScaleX="1"/>
                    </Polyline.RenderTransform>
                </Polyline>
                <Polyline Points="12,0 0,0 0,12" Stroke="#00FF41" StrokeThickness="2"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          RenderTransformOrigin="0.5,0.5">
                    <Polyline.RenderTransform>
                        <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                    </Polyline.RenderTransform>
                </Polyline>

                <StackPanel Margin="8,8">
                    <TextBlock Text="&gt; SETTINGS" Style="{StaticResource HeaderText}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButton}" Command="{Binding ToggleContextMenuCommand}">
                            <Button.Content>
                                <TextBlock FontFamily="Consolas">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="[ INSTALL CONTEXT MENU ]"/>
                                            <Setter Property="Foreground" Value="#00FF41"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContextMenuInstalled}" Value="True">
                                                    <Setter Property="Text" Value="[ REMOVE CONTEXT MENU ]"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="NOT INSTALLED"/>
                                    <Setter Property="Foreground" Value="#4A7A4A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContextMenuInstalled}" Value="True">
                                            <Setter Property="Text" Value="INSTALLED — RIGHT-CLICK IN EXPLORER"/>
                                            <Setter Property="Foreground" Value="#00FF41"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Spacer -->

        <!-- Row 5: Status Bar -->
        <Border Grid.Row="5" Background="#0A0E0A" Padding="20,10,20,12"
                BorderBrush="#00CC33" BorderThickness="0,1,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#00FF41" ShadowDepth="0" BlurRadius="5" Opacity="0.3" Direction="0"/>
            </Border.Effect>
            <StackPanel>
                <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Margin="0,0,0,8"/>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STATUS: " FontSize="12" Foreground="#00802A" FontWeight="Bold"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#B0FFB0"/>
                    </StackPanel>
                    <Button Style="{StaticResource ActionButton}" Content="[ CANCEL ]"
                            Command="{Binding CancelCommand}" HorizontalAlignment="Right"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Foreground="#FFB000" Padding="12,4" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent"
                                        BorderBrush="#FFB000" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3D2A00"/>
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#FFB000" ShadowDepth="0" BlurRadius="10" Opacity="0.5"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
